<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Java web/webLeavesTests.xml: the admin adds a leave for the run's own employee on the web, then deletes it (Java's "Clean up - delete leave" block, a case here); every leave the run made and did not delete is deleted by API before the employee (run 994). Hybrid: one sign-in by quick calls, the employee made and deleted by API. -->
<suite name="Leaves on the web (TS)">
    <parameter name="browser" value="${browserType}"/>
    <parameter name="signedInAs" value="Admin"/>
    <parameter name="employee_password_from" value="Mobile user"/>
    <parameter name="employee_tag" value="webLeave"/>

    <test name="Log in programmatically">
        <classes>
            <class name="ts:tests/api/signIn/logIn.spec.ts">
                <methods><include name="logInProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Set-up - Create employee by API">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="approvedEmployeeProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that the admin can add a leave for the employee from the web">
        <parameter name="leave_type" value="اجازة"/>
        <parameter name="leave_sub_type" value="سنوية"/>
        <parameter name="leave_from_days_ahead" value="1"/>
        <parameter name="leave_to_days_ahead" value="2"/>
        <parameter name="leave_note" value="Trova web leave {run}"/>
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/leaveRequests/adminLeaves.spec.ts">
                <methods><include name="testVerifyThatTheAdminCanAddALeaveForTheEmployeeFromTheWeb"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that the admin can delete the employee's leave from the web">
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/leaveRequests/adminLeaves.spec.ts">
                <methods><include name="testVerifyThatTheAdminCanDeleteTheEmployeesLeaveFromTheWeb"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up - delete the run's leaves by API">
        <classes>
            <class name="ts:tests/api/leaves/webLeaveCleanUp.spec.ts">
                <methods><include name="cleanUpWebLeavesProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up - delete employee by API">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="cleanUpEmployeesProgrammatically"/></methods>
            </class>
        </classes>
    </test>
</suite>
