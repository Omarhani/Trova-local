<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Employee and Leaves (TS)">
    <parameter name="browser" value="${browserType}"/>

    <test name="Log in programmatically">
        <parameter name="signedInAs" value="Admin"/>
        <classes>
            <class name="ts:tests/api/employeeAndLeaves/employeeAndLeaves.spec.ts">
                <methods><include name="logInProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case 181 - Verify that admin can add a new employee with all required fields">
        <parameter name="signedInAs" value="Admin"/>
        <parameter name="employee_first_name" value="Skill"/>
        <parameter name="employee_last_name" value="Tester"/>
        <parameter name="employee_user_name" value="o.hany+skill1+{run}@t2.sa"/>
        <parameter name="employee_job_number" value="SK{run}"/>
        <parameter name="employee_department" value="test"/>
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/employeeAndLeaves/employeeAndLeaves.spec.ts">
                <methods><include name="testAdminCanAddANewEmployeeWithAllRequiredFields"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case 183 - Verify that first name with numbers is rejected">
        <parameter name="signedInAs" value="Admin"/>
        <parameter name="employee_first_name_with_numbers" value="Omar{run}"/>
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/employeeAndLeaves/employeeAndLeaves.spec.ts">
                <methods><include name="testFirstNameWithNumbersIsRejected"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case 182 - Verify that Save stays disabled while a required field is empty">
        <parameter name="signedInAs" value="Admin"/>
        <parameter name="employee_job_number_empty" value=""/>
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/employeeAndLeaves/employeeAndLeaves.spec.ts">
                <methods><include name="testSaveStaysDisabledWhileARequiredFieldIsEmpty"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case 340 - Verify that the admin can add a new employee from Registration Requests">
        <parameter name="signedInAs" value="Admin"/>
        <parameter name="employee_first_name" value="Omar"/>
        <parameter name="employee_last_name" value="Testone"/>
        <parameter name="employee_user_name" value="omar.tc01+{run:340}@t2saas.sa"/>
        <parameter name="employee_job_number" value="TC3110A{run:340}"/>
        <parameter name="employee_job_title" value="QA"/>
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/employeeAndLeaves/employeeAndLeaves.spec.ts">
                <methods><include name="testVerifyThatTheAdminCanAddANewEmployeeFromRegistrationRequests"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up - Delete the employee record (after test 1)">
        <parameter name="signedInAs" value="Admin"/>
        <parameter name="recordKey" value="added_employee_users"/>
        <classes>
            <class name="ts:tests/web/employeeAndLeaves/employeeRecordCleanUp.spec.ts">
                <methods><include name="deleteEmployeeRecord"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case 185 - Verify that job number longer than 20 characters is rejected">
        <parameter name="signedInAs" value="Admin"/>
        <parameter name="employee_job_number" value="SK123456789012345678X{run:185}"/>
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/employeeAndLeaves/employeeAndLeaves.spec.ts">
                <methods><include name="testVerifyThatJobNumberLongerThan20CharactersIsRejected"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up programmatically">
        <parameter name="signedInAs" value="Admin"/>
        <classes>
            <class name="ts:tests/api/employeeAndLeaves/employeeAndLeaves.spec.ts">
                <methods><include name="cleanUpProgrammatically"/></methods>
            </class>
        </classes>
    </test>
</suite>
