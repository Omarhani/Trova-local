<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Java web/webLoginAndRegistration.xml (its refused sign-in cases, LoginTests priorities 1 and 2): the portal shows a message for a wrong password and for a wrong account code, each on a signed-out page. The wrong password is tried only on an employee this run makes by API (never a real account). Hybrid: the admin signs in once by API for set-up and clean-up. -->
<suite name="Sign-in on the web (TS)">
    <parameter name="browser" value="${browserType}"/>
    <parameter name="signedInAs" value="Admin"/>
    <parameter name="server" value="${serverType}"/>
    <parameter name="employee_password_from" value="Mobile user"/>
    <parameter name="employee_tag" value="webLogin"/>

    <test name="Log in programmatically">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="logInProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Set-up - Create employee by API">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="approvedEmployeeProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that the web shows a message for a wrong password">
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/signIn/refusedSignIn.spec.ts">
                <methods><include name="testVerifyThatTheWebShowsAMessageForAWrongPassword"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that the web shows a message for a wrong account code">
        <parameter name="wrong_account_code" value="Autooo"/>
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/signIn/refusedSignIn.spec.ts">
                <methods><include name="testVerifyThatTheWebShowsAMessageForAWrongAccountCode"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up - delete employee by API">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="cleanUpEmployeesProgrammatically"/></methods>
            </class>
        </classes>
    </test>
</suite>
