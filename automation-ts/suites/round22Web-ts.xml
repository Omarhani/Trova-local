<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Round 2.2 (Omar 2026-11-12): two web cases known to pass (Availo project W1/W2, Work plans suite): add a work plan, then edit it. One sign-in by quick calls; the plan this run made is deleted by API last. -->
<suite name="Round 2.2 - Work plans (TS)">
    <parameter name="browser" value="${browserType}"/>
    <parameter name="signedInAs" value="Admin"/>
    <parameter name="plan_name" value="Omar WebPlan {run}"/>

    <test name="Log in programmatically">
        <classes>
            <class name="ts:tests/api/signIn/logIn.spec.ts">
                <methods><include name="logInProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that the admin can add a new work plan">
        <parameter name="plan_country" value="مصر"/>
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/workPlans/workPlans.spec.ts">
                <methods><include name="testVerifyThatTheAdminCanAddANewWorkPlan"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that the admin can edit the work plan">
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/workPlans/workPlans.spec.ts">
                <methods><include name="testVerifyThatTheAdminCanEditTheWorkPlan"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up - delete the work plan by API">
        <classes>
            <class name="ts:tests/api/workPlans/workPlanCleanUp.spec.ts">
                <methods><include name="cleanUpWorkPlansProgrammatically"/></methods>
            </class>
        </classes>
    </test>
</suite>
