<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Java mob/mobOpenLoggedIn.xml: the app opens signed in with the kept sign-in (the case signs the run's employee in once when nothing is kept). -->
<suite name="Open the app signed in (TS)">
    <parameter name="signedInAs" value="Admin"/>
    <parameter name="server" value="${serverType}"/>
    <parameter name="employee_password_from" value="Mobile user"/>
    <parameter name="employee_tag" value="mobOpen"/>

    <test name="Log in programmatically">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="logInProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Set-up - Create employee by API">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="approvedEmployeeProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that the app opens signed in with the kept sign-in">
        <parameter name="keepAppData" value="true"/>
        <groups><run><include name="Mob"/></run></groups>
        <classes>
            <class name="ts:tests/mobile/employeeAccount/employeeAccount.spec.ts">
                <methods><include name="testVerifyThatTheAppOpensSignedInWithTheKeptSignIn"/></methods>
            </class>
        </classes>
    </test>

    <!-- Omar 2026-11-12 (run 985): the optional pop-up rule's trap - the pop-up handled, the check wrong: designed end FAILED -->
    <test name="Case - Trap - the app opens signed in but greets another name ends Failed">
        <parameter name="trap" value="true"/>
        <parameter name="keepAppData" value="true"/>
        <groups><run><include name="Mob"/></run></groups>
        <classes>
            <class name="ts:tests/mobile/employeeAccount/employeeAccount.spec.ts">
                <methods><include name="testTrapTheAppOpensSignedInWithAWrongGreeting"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up - sign the app out">
        <parameter name="keepAppData" value="true"/>
        <groups><run><include name="Mob"/></run></groups>
        <classes>
            <class name="ts:tests/mobile/employeeAccount/appSignOut.spec.ts">
                <methods><include name="signOutOfTheAppProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up - delete employee by API">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="cleanUpEmployeesProgrammatically"/></methods>
            </class>
        </classes>
    </test>
</suite>
