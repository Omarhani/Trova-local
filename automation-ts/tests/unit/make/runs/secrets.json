{
  "runId": 707,
  "caseId": 801,
  "title": "Admin connects the mail box",
  "login": "Admin",
  "mode": "hybrid",
  "values": { "mail_user": "fixture.mail@example.test", "mail_password": "Fixture-Only-Pass-2" },
  "steps": [
    { "step": 0, "text": "Sign in as Admin", "result": "passed",
      "actions": [
        { "on": "web", "page": "/login", "action": "type", "element": "Password",
          "locator": "By.xpath(\"//input[@type='password']\")", "login": "Admin", "field": "Password", "value": "Fixture-Only-Pass-1" },
        { "on": "web", "page": "/login", "action": "login", "login": "Admin" } ] },
    { "step": 1, "text": "Open the Mail settings page", "result": "passed",
      "actions": [ { "on": "web", "page": "/settings/mail", "action": "open" } ] },
    { "step": 2, "text": "Type the mail box user and its password", "result": "passed",
      "actions": [
        { "on": "web", "page": "/settings/mail", "action": "type", "element": "User",
          "locator": "By.xpath(\"//input[@formcontrolname='user']\")", "value": "{mail_user}" },
        { "on": "web", "page": "/settings/mail", "action": "type", "element": "Mail password",
          "locator": "By.xpath(\"//input[@formcontrolname='password']\")", "login": "Mail box", "field": "Password", "value": "Fixture-Only-Pass-3" } ] },
    { "step": 3, "text": "Click Connect", "result": "passed", "expected": "The mail box shows as connected",
      "actions": [ { "on": "web", "page": "/settings/mail", "action": "click", "element": "Connect",
                     "locator": "By.xpath(\"//button[normalize-space()='Connect']\")" } ],
      "saw": ["Connected"] }
  ],
  "setup": [
    { "on": "api", "side": "web", "method": "POST", "path": "/MailBox/Reset", "purpose": "setup",
      "headers": { "Authorization": "Bearer fixture-token-123" },
      "body": { "UserName": "{mail_user}" }, "status": 200 }
  ],
  "cleanup": []
}
