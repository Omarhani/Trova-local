<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Emloyess 2">
    <parameter name="browser" value="${browserType}"/>

    <test name="Log in programmatically">
        <parameter name="signedInAs" value="Admin"/>
        <classes>
            <class name="tests.api.employeeAndLeaves.EmployeeAndLeavesApiTests">
                <methods><include name="logInProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case 340 - Verify that the admin can add a new employee from Registration Requests">
        <parameter name="signedInAs" value="Admin"/>
        <parameter name="employee_first_name" value="Omar"/>
        <parameter name="employee_last_name" value="Testone"/>
        <parameter name="employee_user_name" value="omar.tc01+{run:340}@t2saas.sa"/>
        <parameter name="employee_job_number" value="TC3110A{run:340}"/>
        <parameter name="employee_job_title" value="QA"/>
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="tests.web.emloyess2.Emloyess2Tests">
                <methods><include name="testVerifyThatTheAdminCanAddANewEmployeeFromRegistrationRequests"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case 341 - Verify that the admin can edit the new employee's data">
        <parameter name="signedInAs" value="Admin"/>
        <parameter name="employee_first_name" value="Omarr"/>
        <parameter name="employee_job_title" value="Senior QA"/>
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="tests.web.emloyess2.Emloyess2Tests">
                <methods><include name="testVerifyThatTheAdminCanEditTheNewEmployeesData"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case 342 - Verify that the admin can delete the employee">
        <parameter name="signedInAs" value="Admin"/>
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="tests.web.emloyess2.Emloyess2Tests">
                <methods><include name="testVerifyThatTheAdminCanDeleteTheEmployee"/></methods>
            </class>
        </classes>
    </test>
</suite>
