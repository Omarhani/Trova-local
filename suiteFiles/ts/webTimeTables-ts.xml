<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Java web/webTimeTables.xml, case for case (owner 2026-11-11: one suite per scenario): add plan, edit plan, add shift, filter, a plan with shifts cannot be deleted, a shift with employees cannot be deleted, a shift without employees is deleted, the plan deleted. The employee is made by API because the shift cases put it on the shift. The shift cases use the work plans calendar. Hybrid: one sign-in by quick calls, clean-up by API of only what this run made. -->
<suite name="Work plans (TS)">
    <parameter name="browser" value="${browserType}"/>
    <parameter name="signedInAs" value="Admin"/>
    <parameter name="employee_password_from" value="Mobile user"/>
    <parameter name="employee_tag" value="webPlan"/>
    <parameter name="plan_name" value="Omar WebPlan {run}"/>
    <parameter name="shift_title" value="Omar WebShift {run}"/>

    <test name="Log in programmatically">
        <classes>
            <class name="ts:tests/api/signIn/logIn.spec.ts">
                <methods><include name="logInProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Set-up - Create employee by API">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="approvedEmployeeProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that the admin can add a new work plan">
        <parameter name="plan_country" value="مصر"/>
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/workPlans/workPlans.spec.ts">
                <methods><include name="testVerifyThatTheAdminCanAddANewWorkPlan"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that the admin can edit the work plan">
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/workPlans/workPlans.spec.ts">
                <methods><include name="testVerifyThatTheAdminCanEditTheWorkPlan"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that the admin can add a new regular shift for the employee">
        <parameter name="shift_start" value="10:00 am"/>
        <parameter name="shift_end" value="05:00 pm"/>
        <parameter name="max_check_out" value="08:00 pm"/>
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/workPlans/workPlans.spec.ts">
                <methods><include name="testVerifyThatTheAdminCanAddANewRegularShiftForTheEmployee"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that the plan filter shows only that plan's shifts">
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/workPlans/workPlans.spec.ts">
                <methods><include name="testVerifyThatThePlanFilterShowsOnlyThatPlansShifts"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that a plan with shifts cannot be deleted">
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/workPlans/workPlanDeletes.spec.ts">
                <methods><include name="testVerifyThatAPlanWithShiftsCannotBeDeleted"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that a shift with employees cannot be deleted">
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/workPlans/workPlanDeletes.spec.ts">
                <methods><include name="testVerifyThatAShiftWithEmployeesCannotBeDeleted"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that a shift without employees can be deleted">
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/workPlans/workPlanDeletes.spec.ts">
                <methods><include name="testVerifyThatAShiftWithoutEmployeesCanBeDeleted"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that the admin can delete the work plan">
        <groups><run><include name="Web"/></run></groups>
        <classes>
            <class name="ts:tests/web/workPlans/workPlanDeletes.spec.ts">
                <methods><include name="testVerifyThatTheAdminCanDeleteTheWorkPlan"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up - delete the work plan by API">
        <classes>
            <class name="ts:tests/api/workPlans/workPlanCleanUp.spec.ts">
                <methods><include name="cleanUpWorkPlansProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up - delete employee by API">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="cleanUpEmployeesProgrammatically"/></methods>
            </class>
        </classes>
    </test>
</suite>
