<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Self-healing proof on the phone (Omar 2026-11-11): our renamed My Profile button must be got past by AI help with a treatment WAITING; Android's location question in the way must be answered by AI help and the case PASS; the TRAP (the case expects a name the server does not have) must end FAILED and NEVER be healed; the phone connection lost mid-case must end NOT CHECKED (the test ends only its own connection at the phone server - never airplane mode, Wi-Fi or the cable; the phone and the app keep running). Hybrid: the admin signs in once by API, the run's employee is made and deleted by API and signs in once on the phone. -->
<suite name="Self-healing proof phone (TS)">
    <parameter name="signedInAs" value="Admin"/>
    <parameter name="server" value="${serverType}"/>
    <parameter name="employee_password_from" value="Mobile user"/>
    <parameter name="employee_tag" value="healProof"/>

    <test name="Log in programmatically">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="logInProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Set-up - Create employee by API">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="approvedEmployeeProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <!-- designed end: AI help gets past (taps the real My Profile), treatment WAITING for the renamed button -->
    <test name="Case - Our renamed phone element is got past by AI help (treatment waiting)">
        <parameter name="keepAppData" value="true"/>
        <groups><run><include name="Mob"/></run></groups>
        <classes>
            <class name="ts:tests/mobile/healProof/healProofPhone.spec.ts">
                <methods><include name="healPhoneOurRenamedElement"/></methods>
            </class>
        </classes>
    </test>

    <!-- designed end: PASSED with AI help (it answers the location question, the case goes on); permissions given back after -->
    <test name="Case - Android's location question in the way is answered by AI help and the case passes">
        <parameter name="keepAppData" value="true"/>
        <groups><run><include name="Mob"/></run></groups>
        <classes>
            <class name="ts:tests/mobile/healProof/healProofPhone.spec.ts">
                <methods><include name="healPhoneLocationQuestionInTheWay"/></methods>
            </class>
        </classes>
    </test>

    <!-- designed end: FAILED (Expected the trap name / Actual the real name), NEVER healed - no treatment, no AI pass -->
    <test name="Case - Trap - the phone and the case disagree on the employee's name ends Failed, never healed">
        <parameter name="keepAppData" value="true"/>
        <groups><run><include name="Mob"/></run></groups>
        <classes>
            <class name="ts:tests/mobile/healProof/healProofPhone.spec.ts">
                <methods><include name="healPhoneTrapWrongValue"/></methods>
            </class>
        </classes>
    </test>

    <!-- designed end: NOT CHECKED (Blocked - the phone connection closed during the case); last, the next block opens a new connection -->
    <test name="Case - The phone connection lost mid-case ends Not checked">
        <parameter name="keepAppData" value="true"/>
        <groups><run><include name="Mob"/></run></groups>
        <classes>
            <class name="ts:tests/mobile/healProof/healProofPhone.spec.ts">
                <methods><include name="healPhoneConnectionLost"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up - sign the app out">
        <parameter name="keepAppData" value="true"/>
        <groups><run><include name="Mob"/></run></groups>
        <classes>
            <class name="ts:tests/mobile/employeeAccount/appSignOut.spec.ts">
                <methods><include name="signOutOfTheAppProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up - delete employee by API">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="cleanUpEmployeesProgrammatically"/></methods>
            </class>
        </classes>
    </test>
</suite>
