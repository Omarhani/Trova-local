<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Java hybrid/mobLoginAndRegistration.xml: a wrong account code and a wrong password are refused, an employee made by API logs in on the app, a new employee registers from the app. Change password and open signed in moved to mobPassword-ts and mobOpenLoggedIn-ts, check in / out to hybridCheckInAndOut-ts. Hybrid: the admin signs in once by API for set-up and clean-up. -->
<suite name="Employee account on the phone (TS)">
    <parameter name="signedInAs" value="Admin"/>
    <parameter name="server" value="${serverType}"/>
    <parameter name="employee_password_from" value="Mobile user"/>
    <parameter name="employee_tag" value="mobAccount"/>

    <test name="Log in programmatically">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="logInProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Set-up - Create employee by API">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="approvedEmployeeProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <!-- Java MobLoginTests priority 1: a wrong account code (Java's INV_CODE), the app starts clean -->
    <test name="Case - Verify that the user cannot log in with a wrong account code on the app">
        <parameter name="wrong_account_code" value="Autooo"/>
        <groups><run><include name="Mob"/></run></groups>
        <classes>
            <class name="ts:tests/mobile/employeeAccount/refusedSignIn.spec.ts">
                <methods><include name="testVerifyThatTheUserCannotLogInWithAWrongAccountCode"/></methods>
            </class>
        </classes>
    </test>

    <!-- Java MobLoginTests priority 2: the run's employee with its password + "-wrong" - never a real account -->
    <test name="Case - Verify that the app shows a message for a wrong password">
        <groups><run><include name="Mob"/></run></groups>
        <classes>
            <class name="ts:tests/mobile/employeeAccount/refusedSignIn.spec.ts">
                <methods><include name="testVerifyThatTheAppShowsAMessageForAWrongPassword"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that the approved employee can log in on the app">
        <groups><run><include name="Mob"/></run></groups>
        <classes>
            <class name="ts:tests/mobile/employeeAccount/employeeAccount.spec.ts">
                <methods><include name="testVerifyThatTheApprovedEmployeeCanLogInOnTheApp"/></methods>
            </class>
        </classes>
    </test>

    <test name="Case - Verify that a new employee can register from the app">
        <groups><run><include name="Mob"/></run></groups>
        <classes>
            <class name="ts:tests/mobile/employeeAccount/employeeAccount.spec.ts">
                <methods><include name="testVerifyThatANewEmployeeCanRegisterFromTheApp"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up - sign the app out">
        <parameter name="keepAppData" value="true"/>
        <groups><run><include name="Mob"/></run></groups>
        <classes>
            <class name="ts:tests/mobile/employeeAccount/appSignOut.spec.ts">
                <methods><include name="signOutOfTheAppProgrammatically"/></methods>
            </class>
        </classes>
    </test>

    <test name="Clean up - delete employee by API">
        <classes>
            <class name="ts:tests/api/employeeCycle/employeeSetUp.spec.ts">
                <methods><include name="cleanUpEmployeesProgrammatically"/></methods>
            </class>
        </classes>
    </test>
</suite>
